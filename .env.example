# Copy to .env.local and fill in. .env.local is gitignored.
#
# IMPORTANT: anything prefixed EXPO_PUBLIC_ is compiled into the JavaScript
# bundle and can be read by anyone with the app. That is fine for the two
# values below — the Supabase anon key is designed to be public and is
# protected by the row-level security policies in supabase/migrations — but it
# means you must NEVER put a service-role key, or an Anthropic key, here.

# --- Supabase (optional) ----------------------------------------------------
# Leave unset to run fully local-first. The app works completely without these;
# they only add cloud backup and the parent's own login on a second device.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic (optional, for the content generator only) -------------------
# Used ONLY by `npm run content:generate`, which runs on your computer.
# This is deliberately NOT prefixed EXPO_PUBLIC_, so it never reaches the app
# bundle. The in-app tutor uses a separate key entered in Settings and stored
# in the device keychain.
ANTHROPIC_API_KEY=
